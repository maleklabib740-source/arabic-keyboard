<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية المفتاح العادي -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed_background" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_normal_background" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#20FFFFFF" />
        </shape>
    </item>
</selector>
