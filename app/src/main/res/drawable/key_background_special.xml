<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية المفاتيح الخاصة (Shift, Delete, 123, Enter) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed_background" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#60FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_special_background" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
